# ===========================================
# cc-malware-toolkit Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# .env is gitignored and will not be committed.

# --- Quarantine Encryption ---
# Password for AES-256-CBC encryption of downloaded malware
QUARANTINE_PASSWORD=changeme

# --- API Keys ---
# VirusTotal API key (free tier works)
VIRUSTOTAL_API_KEY=

# abuse.ch API key (shared by MalwareBazaar / ThreatFox / URLHaus)
# Required from late 2025 for all three services.
ABUSECH_AUTH_KEY=

# --- threat-intel skill: extra OSINT services (all optional) ---
# Sources: see .claude/skills/threat-intel/references/api-keys-guide.md
ALIENVAULT_API_KEY=
HYBRID_ANALYSIS_API_KEY=
TRIAGE_API_KEY=
URLSCANIO_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
IPINFO_API_KEY=
VULNCHECK_API_KEY=
NIST_API_KEY=
MALSHARE_API_KEY=
MALPEDIA_API_KEY=

# --- VMware Sandbox ---
# Path to vmrun executable
# Windows: C:\Program Files (x86)\VMware\VMware Workstation\vmrun.exe
# Linux: /usr/bin/vmrun
# macOS: /Applications/VMware Fusion.app/Contents/Library/vmrun
VMRUN_PATH=

# Path to the VM's .vmx file
VM_VMX_PATH=

# Guest OS credentials
VM_GUEST_USER=
VM_GUEST_PASS=

# Guest OS user profile directory (e.g., C:\Users\<username>)
VM_GUEST_PROFILE=

# Clean snapshot name (must match an existing VMware snapshot)
# sandbox.sh default: clean_with_tools_fakenet_ca
VM_SNAPSHOT=clean_with_tools_fakenet_ca

# vmrun command timeout in seconds (default: 120)
# 30s is too short for large file copies or process listing on loaded VMs.
# Recommended: 120 for normal use, 300 for >50MB files or complex guest operations.
VMRUN_TIMEOUT=120

# --- malware-sandbox Level 3: x64dbg-automate リモートドライバ ---
# tools/malware-sandbox/x64dbg_driver.py がゲストVM内の x64dbg に ZeroMQ で接続する。
# セットアップ手順: tools/malware-sandbox/docs/VM-SETUP.md の
# 「Step 3.5: x64dbg-automate プラグイン（Level 3 用）」を参照。
#
# 【警告】この RPC には認証が一切ない。到達できる者は誰でも（同一ゲスト内の
# 検体を含む）任意メモリ書き込みと任意デバッガコマンド実行ができる。
# 許容できるのはゲストが使い捨て・Host-Only 隔離された VM である場合のみ。
# ドライバは RFC1918 以外のアドレスへの接続を拒否する（ループバックも拒否:
# 127.0.0.1 はホスト上で検体を起動することを意味するため）。

# ゲストVMの Host-Only アドレス（RFC1918 のみ。ゲストで ipconfig して確認する）
# 例: 192.168.x.y / 10.x.y.z / 172.16-31.x.y
VM_X64DBG_HOST=

# プラグインの待受ポート（x64dbg.ini の [XAutomate] ReqRepPort / PubSubPort と一致させる）
VM_X64DBG_REQ_PORT=27066
VM_X64DBG_PUB_PORT=27067

# ゲスト内の x64dbg.exe 絶対パス（sandbox.sh が vmrun で起動する際に使用）
# 既定: <GUEST_TOOLS>\x64dbg\release\x64\x64dbg.exe
VM_X64DBG_EXE=

# 固定バージョンペア（変更しないこと。片方だけ上げると接続時に AssertionError）
#   pip パッケージ : x64dbg_automate==0.9.2   (COMPAT_VERSION = ghost_fungus)
#   ゲストプラグイン: v0.8.1-ghost_fungus / release64-0.8.1-ghost_fungus.zip
